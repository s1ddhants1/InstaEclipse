<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">


    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:description="@string/module_description"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.InstaEclipse"
        tools:targetApi="31">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".mods.devops.config.JsonImportActivity"
            android:exported="true"
            android:theme="@style/Theme.InstaEclipse">
        </activity>

        <activity
            android:name=".mods.devops.config.JsonExportActivity"
            android:exported="true"
            android:theme="@style/Theme.InstaEclipse" />

        <activity
            android:name=".mods.location.LocationPickerActivity"
            android:exported="true"
            android:theme="@style/Theme.InstaEclipse" />

        <activity
            android:name=".ui.theme.ThemeCustomizerActivity"
            android:exported="true"
            android:theme="@style/Theme.InstaEclipse" />

        <!-- Companion-app service: receives downloaded file (via ParcelFileDescriptor) from the
             Xposed module (running in Instagram's process) and writes it to the SAF folder
             whose permission belongs to the companion app. -->
        <service
            android:name=".mods.media.DownloadSaveService"
            android:exported="true"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name=".provider.PreferencesProvider"
            android:authorities="ps.reso.instaeclipse.preferences"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!-- Modern LibXposed framework service binder provider -->
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="${applicationId}.XposedService"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />


    </application>

    <!-- Permissions -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="ManifestOrder,QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- For Android 11+ broad storage access -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Foreground service (required API 28+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- dataSync foreground service type (required API 34+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Post notifications (required API 33+ to show download progress) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />


</manifest>
